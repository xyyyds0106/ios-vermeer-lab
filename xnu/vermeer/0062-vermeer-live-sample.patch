  * SWEET process sampler (bsd/dev/sweet_sample.c): user pc/lr/sp and a frame
  * pointer backtrace of every thread of a task, from the saved user state.
  */
+#include <kern/vermeer_sample_images.h>
+struct vermeer_sample_context { vm_map_t map; const char *name; int pid; };
+static int vermeer_sample_read(void *opaque,uint64_t address,void *out,unsigned size)
+{
+    struct vermeer_sample_context *context=opaque;
+    return vm_map_read_user(context->map,address,out,size)==KERN_SUCCESS;
+}
+static void vermeer_sample_image(void *opaque,uint64_t base,const char *path)
+{
+    struct vermeer_sample_context *context=opaque;
+    printf("IMG %s[%d] base 0x%llx path %s\n",context->name,context->pid,base,path);
+}
