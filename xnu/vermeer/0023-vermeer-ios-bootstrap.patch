+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* First-boot metadata uses the same authorized mkdir path as the syscall. */
+int vermeer_ios_mkdir(const char *path, vfs_context_t ctx);
+int
+vermeer_ios_mkdir(const char *path, vfs_context_t ctx)
+{
+    struct vnode_attr va;
+    VATTR_INIT(&va);
+    VATTR_SET(&va, va_mode, 0700);
+    VATTR_SET(&va, va_uid, 0);
+    VATTR_SET(&va, va_gid, 0);
+    return mkdir1at(ctx, CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+#endif
